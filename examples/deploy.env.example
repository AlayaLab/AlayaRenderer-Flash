# Profile for `alayarender-flash serve --config deploy.env`.
# Copy, then set the three paths marked REQUIRED. Everything else defaults to the
# public SuperTuxKart deployment (single GPU, 4 steps, 832x448 output).

# REQUIRED: SuperTuxKart binary with G-buffer export (see integrations/supertuxkart/README.md)
ALAYA_STK_BINARY=/path/to/stk-code/cmake_build/bin/supertuxkart
# REQUIRED: local snapshots (`alayarender-flash download` prints the cache paths)
ALAYA_BASE_MODEL=/path/to/Wan2.1-T2V-1.3B-Diffusers
ALAYA_MODEL_CHECKPOINT=/path/to/AlayaRenderer-Flash

ALAYA_MODEL_PROFILE=stk-checkpoint-600-grouped
ALAYA_REQUIRE_PINNED_WEIGHTS=0

# Scene and resolution
ALAYA_TRACK=black_forest
ALAYA_PROMPT='natural daylight forest rally, balanced colors, realistic game render'
ALAYA_SOURCE_WIDTH=960
ALAYA_SOURCE_HEIGHT=540
ALAYA_MODEL_WIDTH=832
ALAYA_MODEL_HEIGHT=448
ALAYA_PREVIEW_WIDTH=720
ALAYA_PREVIEW_GBUFFER_WIDTH=360

# Model schedule (must match the checkpoint)
ALAYA_NUM_INFERENCE_STEPS=4
ALAYA_LATENT_WINDOW=4
ALAYA_INITIAL_PIXEL_FRAMES=13
ALAYA_RESUMED_PIXEL_FRAMES=16
ALAYA_SMALL_ENCODER_MODE=grouped
ALAYA_SMALL_ENCODER_DIM=128
ALAYA_GROUPED_ENCODER_BRANCHES=5
ALAYA_WINDOW_TRANSPORT=shm_slots
ALAYA_COMPILE_MODE=all
ALAYA_WARMUP_CHUNKS=2

# Pacing
ALAYA_TARGET_FPS=31.0
ALAYA_PUBLISH_FPS=33.0
ALAYA_PUBLISH_SOURCE_FPS=31.0
ALAYA_PUBLISH_QUEUE_FRAMES=48
ALAYA_PUBLISH_BUFFER_FRAMES=2.5
ALAYA_PUBLISH_MIN_FPS=12.0

# GPUs: STK (EGL) and the worker share GPU 0 by default.
ALAYA_STK_EGL_DEVICE=0
ALAYA_WORKER_GPU=0
ALAYA_STK_GFX_PRESET=3
ALAYA_STK_HANDOVER_GRACE=5

# Web preview (loopback only; tunnel or reverse-proxy it)
ALAYA_PREVIEW_HOST=127.0.0.1
ALAYA_PREVIEW_PORT=8095
ALAYA_PUBLIC_PORT=8095
ALAYA_PREVIEW_MAX_FPS=36
# Public origin(s) the reverse proxy serves, comma-separated; browser POST and
# WebSocket requests from any other origin are rejected.
# ALAYA_PREVIEW_ALLOWED_ORIGINS=https://demo.example.org
# Recording (/record/start, /record/stop) is disabled unless this file holds
# an operator token; requests must send it as X-Alaya-Admin-Token.
# ALAYA_PREVIEW_ADMIN_TOKEN_FILE=/etc/alaya/preview-admin-token

# Writable state, compile caches and the Hugging Face cache with the kernels
ALAYA_WRITABLE_ROOT=${ALAYA_WRITABLE_ROOT:-${PWD}/.runtime}
ALAYA_STATE_DIR=${ALAYA_WRITABLE_ROOT}/state
ALAYA_CACHE_ROOT=${ALAYA_WRITABLE_ROOT}/cache
ALAYA_HF_HOME=${HF_HOME:-${HOME}/.cache/huggingface}
# Service logs are rotated in place at this size, keeping this many backups.
ALAYA_LOG_MAX_BYTES=52428800
ALAYA_LOG_BACKUPS=3
ALAYA_RUNTIME_BASE=/dev/shm/alaya_renderer_flash
ALAYA_READY_TIMEOUT_STK=60
ALAYA_READY_TIMEOUT_BRIDGE=60
ALAYA_READY_TIMEOUT_WORKER=1200
ALAYA_READY_TIMEOUT_PREVIEW=60
ALAYA_STOP_TIMEOUT=20
ALAYA_RESTART_DELAY=2
